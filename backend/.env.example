# --- LLM provider (Groq, wired via the LLMProvider abstraction) ---
# NOTE: CLAUDE.md names "Grok" (xAI) as the reference provider; this build uses
# Groq (api.groq.com) instead per explicit product decision. Swapping to xAI later
# only requires adding a GrokProvider implementation of the same LLMProvider interface.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Neo4j Aura (cloud, no local Docker required) ---
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Cloned repos land here. Keep this under backend/ (simplest for local dev),
# but if you run uvicorn with --reload, pass --reload-exclude "workspace/**"
# too — otherwise the clone's own .py files trigger a reload mid-analysis.
WORKSPACE_DIR=./workspace
MAX_REPO_SIZE_MB=500
MAX_REPO_FILES=5000
